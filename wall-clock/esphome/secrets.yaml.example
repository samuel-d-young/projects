# Copy to secrets.yaml in the ESPHome Device Builder config directory.
# secrets.yaml is shared across all your ESPHome devices — these keys are
# namespaced with wall_clock_ so they can sit alongside your other devices.

wifi_ssid: "YOUR_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate with:  openssl rand -base64 32
# API *password* auth was removed in ESPHome 2026.1.0 — this must be a key.
wall_clock_api_key: "PASTE_32_BYTE_BASE64_KEY_HERE"

wall_clock_ota_password: "choose-something-long"
wall_clock_ap_password: "fallback-hotspot-password"
