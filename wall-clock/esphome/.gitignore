# Never commit real credentials. secrets.yaml lives on the HA box, in
# /config/esphome/secrets.yaml, and is referenced from the configs via !secret.
secrets.yaml

# esphome build cache, written by `esphome config`/`run`
.esphome/
zacs-clock.yaml
jakes-clock.yaml
# workbench-only wrappers that build the local file instead of the GitHub branch
local-*.yaml
